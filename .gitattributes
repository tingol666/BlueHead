# Keep authored source predictable on every checkout.
* text=auto eol=lf
# These files have byte-for-byte source or binary hashes. Never rewrite them.
/vendor/** -text -whitespace
/licenses/** -text -whitespace
/bluehead/assets/** -text
/bluehead/assets/firmware/LICENCE.* -whitespace
*.png -text
*.ico -text
*.dll -text
*.exe -text
*.zip -text
*.gz -text
*.bz2 -text
