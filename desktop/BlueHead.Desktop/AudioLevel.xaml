<UserControl x:Class="BlueHead.Desktop.AudioLevel" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Focusable="False">
 <Grid>
  <ToggleButton x:Name="Opener" IsChecked="{Binding IsOpen, ElementName=Root, Mode=TwoWay}" PreviewMouseLeftButtonDown="OpenerMouseDown" Cursor="Hand" HorizontalContentAlignment="Stretch">
   <ToggleButton.ToolTip><TextBlock><Run Text="{Binding Label, ElementName=Root}"/><Run Text=" · 点击调节音量"/><LineBreak/><Run Text="{Binding Secondary, ElementName=Root}"/></TextBlock></ToggleButton.ToolTip>
   <AutomationProperties.Name><MultiBinding StringFormat="{}{0}，{1:0}%，点击调节"><Binding Path="Label" ElementName="Root"/><Binding Path="Value" ElementName="Root"/></MultiBinding></AutomationProperties.Name>
   <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Padding" Value="8,5"/><Setter Property="Background" Value="#FAFBFD"/><Setter Property="BorderBrush" Value="#E3ECEF"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#ECF8F3"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#E6F8EF"/><Setter TargetName="Face" Property="BorderBrush" Value="#C5EBD6"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#078B4E"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True"><Setter Property="Padding" Value="8,4"/><Setter Property="Background" Value="#F3F6F7"/></DataTrigger></Style.Triggers>
   </Style></ToggleButton.Style>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Icon, ElementName=Root}"/><Setter Property="Foreground" Value="{StaticResource AudioAccent}"/><Style.Triggers><DataTrigger Binding="{Binding IsSilent, ElementName=Root}" Value="True"><Setter Property="Text" Value="&#xE74F;"/><Setter Property="Foreground" Value="#AD533E"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <StackPanel Grid.Column="1" Margin="8,0,4,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding Label, ElementName=Root}" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"><TextBlock Text="{Binding CompactLabel, ElementName=Root}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,5,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Value, ElementName=Root, StringFormat={}{0:0}%}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" Foreground="#8C9DA5" FontSize="8" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel>
   </Grid>
  </ToggleButton>
  <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=Opener}" Placement="Top" VerticalOffset="-8" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsOpen, ElementName=Root, Mode=TwoWay}" Opened="FlyoutOpened" Closed="FlyoutClosed">
   <Border x:Name="Panel" Background="White" BorderBrush="#DDE5E7" BorderThickness="1" CornerRadius="12" Padding="18" Width="316" Margin="8" PreviewKeyDown="PanelKeyDown" DataContext="{Binding DataContext, ElementName=Root}">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.1"/></Border.Effect>
    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label, ElementName=Root}" FontSize="16" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Value, ElementName=Root, StringFormat={}{0:0}%}" FontSize="17" Foreground="{StaticResource Accent}"/></Grid>
     <TextBlock Text="{Binding Hint, ElementName=Root}" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
     <ContentControl Content="{Binding EditorContent, ElementName=Root}" Margin="0,0,0,14"><ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
     <Slider x:Name="LevelSlider" Minimum="0" Maximum="200" Value="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdjust, ElementName=Root}" SmallChange="1" LargeChange="10" TickFrequency="100" IsSnapToTickEnabled="False" AutomationProperties.Name="{Binding Label, ElementName=Root}" Height="30"/>
     <Grid Margin="0,3,0,10"><TextBlock Text="0%" Style="{StaticResource Caption}"/><TextBlock Text="100%" Style="{StaticResource Caption}" HorizontalAlignment="Center"/><TextBlock Text="200%" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:Button Content="恢复 100%" Click="ResetClick" IsEnabled="{Binding CanAdjust, ElementName=Root}" HorizontalAlignment="Left" Padding="10,6" FontSize="12"/><ui:Button Grid.Column="1" Click="SilenceClick" IsEnabled="{Binding CanAdjust, ElementName=Root}" Padding="10,6" FontSize="12" AutomationProperties.Name="静音或恢复此路音量"><TextBlock FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="静音"/><Style.Triggers><DataTrigger Binding="{Binding IsSilent, ElementName=Root}" Value="True"><Setter Property="Text" Value="取消静音"/><Setter Property="Foreground" Value="#AD533E"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></ui:Button></Grid>
     <ContentControl Content="{Binding FooterContent, ElementName=Root}" Margin="0,16,0,0"><ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
