<Window x:Class="BlueHead.Desktop.CodecPolicyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="连接与编码 · BlueHead" Width="450" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F6F9F8" Foreground="{StaticResource Ink}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,16">
  <TextBlock Text="连接与编码" FontSize="19" FontWeight="SemiBold"/>
  <TextBlock Text="选择允许的格式，右侧齿轮调参数。" Style="{StaticResource Caption}" Margin="0,5,0,12"/>
  <Border Style="{StaticResource Card}" Padding="12,10"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="连接偏好" VerticalAlignment="Center"/>
   <ComboBox x:Name="PolicyPicker" Grid.Column="1" SelectionChanged="PolicyChanged" AutomationProperties.Name="连接偏好"><ComboBoxItem Content="优先 LE Audio / LC3" Tag="prefer_le"/><ComboBoxItem Content="仅经典蓝牙" Tag="classic"/></ComboBox></Grid>
   <TextBlock x:Name="PolicyExplanation" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0"><StackPanel>
   <TextBlock Text="允许的经典蓝牙编码" FontWeight="SemiBold"/>
   <TextBlock Text="勾选后向设备提供此编码；右侧齿轮可调参数。" Style="{StaticResource Caption}" Margin="0,5,0,7"/>
   <StackPanel x:Name="CodecChecks"/>
   <Border Height="1" Background="{StaticResource Line}" Margin="0,9"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="首选编码" VerticalAlignment="Center"/>
   <ComboBox x:Name="PreferencePicker" Grid.Column="1" SelectionChanged="PreferenceChanged" AutomationProperties.Name="首选媒体编码"/></Grid>
   <TextBlock Text="按音质倾向和蓝牙带宽占用选择；实际格式看设备卡片。" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <TextBlock x:Name="SaveState" Text="修改自动保存。编码和参数需断开并重新连接设备；连接偏好需停止接收，再开始接收。" Style="{StaticResource Caption}" Margin="0,12,0,10" AutomationProperties.LiveSetting="Polite"/>
  <ui:Button Content="完成" Click="DoneClick" HorizontalAlignment="Right" Appearance="Primary" Padding="14,5"/>
 </StackPanel></ScrollViewer>
</Window>
