<Window x:Class="BlueHead.Desktop.DeviceCodecWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="编码与音质 · BlueHead" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F6F9F8" Foreground="{StaticResource Ink}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,16">
  <TextBlock x:Name="DeviceTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
  <TextBlock Text="编码与音质 · 仅本次连接" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,5,0,14"/>
  <Border Background="#EAF7F0" CornerRadius="8" Padding="12,9"><StackPanel><TextBlock Text="实际生效" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ActualFormat" Text="正在读取…" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0"><StackPanel x:Name="Choices">
   <TextBlock Text="媒体编码"/>
   <ComboBox x:Name="Codec" SelectionChanged="CodecChanged" Margin="0,7,0,9" AutomationProperties.Name="此设备的媒体编码"/>
   <TextBlock x:Name="CodecReason" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="采样率"/><ComboBox x:Name="Rate" Margin="0,7,0,0" AutomationProperties.Name="此设备的采样率"/></StackPanel>
    <StackPanel x:Name="DepthRow" Grid.Column="2"><TextBlock Text="位深"/><ComboBox x:Name="Depth" Margin="0,7,0,0" AutomationProperties.Name="此设备的位深"/></StackPanel>
   </Grid>
   <StackPanel x:Name="BitrateRow" Margin="0,10,0,0"><TextBlock Text="AAC 码率上限"/><ComboBox x:Name="Bitrate" Margin="0,7,0,0" AutomationProperties.Name="此设备的 AAC 码率上限"/></StackPanel>
   <StackPanel x:Name="QualityRow" Margin="0,10,0,0"><TextBlock Text="允许的质量范围"/><ComboBox x:Name="Quality" Margin="0,7,0,0" AutomationProperties.Name="此设备的媒体质量范围"/><TextBlock Text="限制发送码率／位池上限；实际质量仍由发送设备选择。" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
   <TextBlock x:Name="QualityReason" Style="{StaticResource Caption}" Margin="0,9,0,0"/>
  </StackPanel></Border>
  <TextBlock x:Name="Status" Text="正在读取这台设备的真实能力…" Style="{StaticResource Caption}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="应用时声音会短暂中断，不影响其它设备。断开后恢复全局偏好；通话或录音期间暂不调整媒体格式。" Style="{StaticResource Caption}" Margin="0,8,0,12"/>
  <DockPanel LastChildFill="False">
   <ui:Button x:Name="Refresh" Content="重新读取" Click="RefreshClick" Padding="9,5"/>
   <ui:Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="应用到此设备" Appearance="Primary" Click="ApplyClick" Padding="12,5" IsEnabled="False"/>
  </DockPanel>
 </StackPanel></ScrollViewer>
</Window>
