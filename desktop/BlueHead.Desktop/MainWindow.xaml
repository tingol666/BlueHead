     <local:BroadcastPanel x:Name="BroadcastPage" Visibility="Collapsed"/>

     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>

      <TextBlock Text="设置" Style="{StaticResource Heading}"/><TextBlock Text="修改自动保存。连接设置在下次开始接收时生效；音量和声音设备可在音频中心随时调整。" Foreground="{StaticResource Muted}" Margin="0,7,0,22"/>

