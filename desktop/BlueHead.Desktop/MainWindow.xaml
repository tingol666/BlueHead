      <Border Style="{StaticResource Card}"><StackPanel>

       <StackPanel x:Name="SharedNameFields" Visibility="Collapsed"><TextBlock Text="系统蓝牙" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="设备配对与电脑蓝牙名称在 Windows 中管理。" Style="{StaticResource Caption}" Margin="0,8,0,8"/><ui:Button Content="打开 Windows 蓝牙 ↗" Click="WindowsBluetoothClick" HorizontalAlignment="Left" Padding="8,4"/></StackPanel>
       <StackPanel x:Name="DedicatedNameFields"><TextBlock Text="电脑对外显示的名称" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="其他设备连接时看到的名称" FontSize="12" Margin="0,20,0,8"/><TextBox x:Name="NameEntry" Text="BlueHead PC" MaxLength="80"/><TextBlock Text="显示在移动设备的蓝牙列表中" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>

       <Grid x:Name="VoiceSettingsRow" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="蓝牙语音与麦克风"/><TextBlock x:Name="VoiceCodecHint" Text="语音编码：自动协商；用于通话及支持蓝牙麦克风的录音、录像应用" Style="{StaticResource Caption}" Margin="0,5,12,0"/></StackPanel><CheckBox x:Name="CallsToggle" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="启用蓝牙语音与麦克风"/></Grid>

       <Grid x:Name="VoiceProtectionRow" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="通话／语音保护"/><TextBlock Text="开启后，设备使用电脑麦克风进行通话、录音或录像时，会暂时断开其它设备并阻止新连接，避免蓝牙中断。使用结束后可重新连接。默认开启；先在音频中心点“停止接收”，修改后自动保存。" Style="{StaticResource Caption}" Margin="0,5,14,0"/></StackPanel><CheckBox x:Name="VoiceProtectionToggle" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="通话／语音保护"/></Grid>
      </StackPanel></Border>

