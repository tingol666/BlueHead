<ui:FluentWindow x:Class="BlueHead.Desktop.MainWindow"

 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:BlueHead.Desktop"

 Title="{x:Static local:AppVersion.Title}" Width="940" Height="580" MinWidth="860" MinHeight="480" WindowStartupLocation="CenterScreen"

 Background="#F7FAFB" Foreground="#26303C" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

 <Grid Background="#F7FAFB">

  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <ui:TitleBar Title="{x:Static local:AppVersion.Title}" Grid.Row="0" Padding="16,0" />

  <Grid Grid.Row="1">

   <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border Background="#F0F6F7" BorderBrush="#E0EAED" BorderThickness="0,0,1,0">

    <DockPanel Margin="10,19,10,16">

     <StackPanel DockPanel.Dock="Bottom" Margin="14,0,0,0"><TextBlock x:Name="SidebarVersion" Text="{x:Static local:AppVersion.Label}" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse Width="5" Height="5" Fill="#0A8A7A" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="本机蓝牙连接" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>

     <StackPanel>

      <StackPanel Orientation="Horizontal" Margin="6,0,0,22"><Border Background="#07C160" Width="26" Height="26" CornerRadius="8"><TextBlock Text="&#xE95B;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"><Hyperlink x:Name="BrandProjectLink" NavigateUri="{x:Static local:ProjectLinks.Repository}" RequestNavigate="ProjectNavigate" TextDecorations="{x:Null}" Foreground="{StaticResource Ink}" ToolTip="GitHub 项目主页 · https://github.com/tingol666/BlueHead" AutomationProperties.Name="BlueHead GitHub 项目主页">BlueHead<Run Text=" ↗" FontSize="11" Foreground="{StaticResource Accent}"/></Hyperlink></TextBlock></StackPanel>

      <Button x:Name="NavHome" Style="{StaticResource Nav}" Click="HomeClick" AutomationProperties.Name="音频中心"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="音频中心"/></StackPanel></Button>

      <Button x:Name="NavAdapters" Style="{StaticResource Nav}" Click="AdaptersClick" AutomationProperties.Name="蓝牙设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE702;" Style="{StaticResource NavIcon}"/><TextBlock Text="蓝牙设置"/></StackPanel></Button>

      <Button x:Name="NavSettings" Style="{StaticResource Nav}" Click="SettingsClick" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="设置"/></StackPanel></Button>

      <Button x:Name="NavHelp" Style="{StaticResource Nav}" Click="HelpClick" AutomationProperties.Name="帮助与诊断"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}"/><TextBlock Text="帮助与诊断"/></StackPanel></Button>

     </StackPanel>

    </DockPanel>

   </Border>

   <Grid Grid.Column="1" Margin="20,15,20,10">

    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border x:Name="Notice" Visibility="Collapsed" Background="#FFF2DF" CornerRadius="7" Padding="9,7" Margin="0,0,0,10"><TextBlock x:Name="NoticeText" Foreground="#805015"/></Border>

    <Grid Grid.Row="1">

     <Grid x:Name="HomePage">

      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Grid x:Name="HomeHeader" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

       <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="音频中心" Style="{StaticResource Heading}" VerticalAlignment="Center"/><TextBlock x:Name="DeviceCount" Text="0 台设备" FontSize="11" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>

       <StackPanel x:Name="ReceptionStatus" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><StackPanel.ToolTip><ToolTip><TextBlock x:Name="StatusDetail" Text="检查本机蓝牙与音频设备…" MaxWidth="300"/></ToolTip></StackPanel.ToolTip><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#98A1AF" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="StatusTitle" Text="正在准备" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/><TextBlock x:Name="MutedIndicator" Text="发送暂停" Visibility="Collapsed" Foreground="#A45E28" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>

       <ui:Button x:Name="StartButton" Grid.Column="2" Content="正在准备…" IsEnabled="False" Appearance="Primary" VerticalAlignment="Center" Padding="12,5" Click="StartClick" AutomationProperties.Name="开始接收或设置蓝牙接收"/>

      </Grid>

      <ScrollViewer x:Name="HomeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">

       <StackPanel>

        <Border x:Name="SharedModeNotice" Background="#EEF8F7" CornerRadius="8" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed"><DockPanel><ui:Button Content="使用电脑麦克风 ↗" DockPanel.Dock="Right" Click="DedicatedSetupClick" Padding="6,3" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/><TextBlock Text="共用 Windows 蓝牙 · 仅接收媒体。麦克风与混音需专用接收。" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>

        <Border x:Name="MediaProfileCard" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8"><StackPanel>

         <Grid x:Name="PlaybackOptionsRow"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

          <TextBlock Text="出声方式" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>

          <ComboBox x:Name="PlaybackModePicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="PlaybackModeChanged" AutomationProperties.Name="出声方式，单设备自动接替或多设备同时播放"><ComboBox.ToolTip><ToolTip><TextBlock x:Name="MediaModeHint" Text="多设备声音一起播放，可分别调节音量。" MaxWidth="320"/></ToolTip></ComboBox.ToolTip><ComboBoxItem Content="多设备同时播放" Tag="mix"/><ComboBoxItem Content="单设备自动接替" Tag="single"/></ComboBox>

          <TextBlock x:Name="SharedPlaybackValue" Grid.Column="1" Text="Windows 管理" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/>

          <TextBlock x:Name="MediaCodecLabel" Grid.Column="3" Text="媒体编码" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>

          <ComboBox x:Name="CodecPicker" Grid.Column="4" SelectedIndex="0" SelectionChanged="CodecChanged" AutomationProperties.Name="媒体编码与码率" ToolTipService.ShowOnDisabled="True"><ComboBox.ToolTip><ToolTip><TextBlock x:Name="CodecHint" Text="优先协商可用高清媒体编码；多设备断续时可切换 AAC。仅影响媒体播放，语音编码自动协商。" MaxWidth="320"/></ToolTip></ComboBox.ToolTip><ComboBoxItem Content="自动 · 优先高清" Tag="auto"/><ComboBoxItem Content="aptX HD · 高清" Tag="aptx_hd"/><ComboBoxItem Content="aptX" Tag="aptx"/><ComboBoxItem Content="AAC · 最高 320 kb/s" Tag="aac"/><ComboBoxItem Content="AAC · 最高 192 kb/s" Tag="aac_192"/><ComboBoxItem Content="SBC · 兼容优先" Tag="sbc"/><ComboBoxItem Content="LDAC · 实验" Tag="ldac"/></ComboBox>

          <TextBlock x:Name="SharedCodecValue" Grid.Column="4" Text="Windows 自动选择" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/>

          <StackPanel x:Name="CodecApplyRow" Grid.Column="5" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"><ui:Button x:Name="ApplyCodecButton" Content="应用" Click="ApplyCodecClick" Appearance="Primary" Padding="10,4" AutomationProperties.Name="应用媒体编码设置"/></StackPanel>

         </Grid>

         <TextBlock x:Name="CodecApplyHint" Text="媒体编码在下一次连接时生效。" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Visibility, ElementName=CodecApplyRow}"/>

         <Border x:Name="MultipointNotice" Visibility="Collapsed" Background="#FFF7EB" CornerRadius="6" Padding="8,6" Margin="0,7,0,0"><DockPanel><ui:Button x:Name="LowerBitrateButton" DockPanel.Dock="Right" Content="切换 AAC 并重连" Click="LowerBitrateClick" Margin="8,0,0,0" Padding="8,4" VerticalAlignment="Center"/><TextBlock x:Name="MultipointText" Style="{StaticResource Caption}" Foreground="#946032" VerticalAlignment="Center"/></DockPanel></Border>

        </StackPanel></Border>

        <Border x:Name="SetupCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10">

         <StackPanel><TextBlock x:Name="SetupTitle" Text="开始之前，设置蓝牙接收" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SetupDescription" Text="让移动设备把电脑识别为蓝牙耳机，需要先准备一个接收适配器。" Foreground="{StaticResource Muted}" Margin="0,10,0,22" TextWrapping="Wrap"/>

          <Border x:Name="SetupBenefits" Background="#F0FAF5" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="声音与麦克风" FontWeight="SemiBold"/><TextBlock Text="使用一个专用蓝牙适配器，支持双向语音、电脑麦克风与多设备混音。内置或外置均可；应用会备份原驱动，之后可恢复。" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel></Border>

          <ui:Button x:Name="SetupAction" Content="设置蓝牙接收" Appearance="Primary" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SetupBluetoothClick" Padding="12,5"/>

          <TextBlock x:Name="SetupCaption" Text="只需在电脑收听？在下一步选择“与 Windows 共用蓝牙”，无需更换驱动。" Style="{StaticResource Caption}" Margin="0,14,0,0"/>

         </StackPanel>

        </Border>

        <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="30" Height="34" CornerRadius="8" Background="#F0F2F6" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="&#xE95B;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="等待设备连接" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PairingHint" Text="开始接收后，在移动设备的蓝牙设置中连接 BlueHead PC。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><ui:Button Grid.Column="2" Content="连接步骤" Click="PairingClick" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Padding="6,4"/></Grid></Border>

        <ItemsControl x:Name="DeviceCards" ItemsSource="{Binding Devices}">

         <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:DeviceCard}">

          <Border Style="{StaticResource Card}" Padding="12,7" Margin="0,0,0,5">

           <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Width="24" Height="28" CornerRadius="6" Background="#F0F2F6" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons" Foreground="#7C8797" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

            <Grid x:Name="DeviceNameLine" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Name}"><TextBlock.MaxWidth><MultiBinding Converter="{StaticResource InlineWidth}" ConverterParameter="8"><Binding ElementName="DeviceNameLine" Path="ActualWidth"/><Binding ElementName="SelectionBadge" Path="ActualWidth"/><Binding Path="CanSelectMedia"/></MultiBinding></TextBlock.MaxWidth></TextBlock>
             <ui:Button x:Name="SelectionBadge" Grid.Column="1" Content="{Binding MediaAction}" Visibility="{Binding CanSelectMedia, Converter={StaticResource Visible}}" Click="SelectMediaClick" Padding="7,2" MinHeight="22" FontSize="11" Margin="8,0,0,0" ToolTip="点击立即切换；当前设备停止传音后会自动接替"><ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Background" Value="#F5F6F8"/><Setter Property="Foreground" Value="#6B7686"/><Setter Property="BorderBrush" Value="#E3ECEF"/><Style.Triggers><DataTrigger Binding="{Binding IsMediaSelected}" Value="True"><Setter Property="Background" Value="#E8F8EF"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="#CDEDDC"/></DataTrigger></Style.Triggers></Style></ui:Button.Style></ui:Button>
            </Grid>

            <StackPanel x:Name="DeviceActions" Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">

             <ui:Button Content="接听" Appearance="Primary" Visibility="{Binding CanAnswer, Converter={StaticResource Visible}}" IsEnabled="{Binding CanAnswer}" Margin="0,0,6,0" Click="AnswerClick" Padding="9,4"/>

             <local:AudioLevel Label="此设备 → 电脑" CompactLabel="播放" Hint="仅调节此设备在电脑上播放的音量。" Compact="True" Value="{Binding Volume, Mode=TwoWay}" ValueChanged="GainChanged" IsEnabled="{Binding CanMix}" Margin="0,0,6,0"/>

             <local:AudioLevel Label="发送到此设备" CompactLabel="麦克风发送" Hint="麦克风与已加入的电脑声音合并后，调节发给此设备的音量。" Icon="&#xE720;" Compact="True" Value="{Binding UplinkVolume, Mode=TwoWay}" ValueChanged="UplinkGainChanged" IsEnabled="{Binding CanMix}"/>

             <ui:Button ToolTip="设备操作" AutomationProperties.Name="设备操作" Padding="6,4" MinHeight="26" BorderThickness="0" Background="Transparent" Margin="5,0,0,0"><ui:Button.Content><TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="14"/></ui:Button.Content><ui:Button.ContextMenu><ContextMenu><MenuItem Header="设为麦克风发送设备" Click="SelectCallClick" IsEnabled="{Binding CanMix}"/><MenuItem Header="连接语音通道" Click="CallAudioClick" IsEnabled="{Binding CanMix}"/><Separator/><MenuItem Header="断开连接" Click="DisconnectClick"/></ContextMenu></ui:Button.ContextMenu><ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><EventSetter Event="Click" Handler="DeviceMenuClick"/></Style></ui:Button.Style></ui:Button>

            </StackPanel>

            <Grid x:Name="DeviceMetadataLine" Grid.Row="1" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding MediaDescription}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding MediaDescription}"><TextBlock.MaxWidth><MultiBinding Converter="{StaticResource InlineWidth}" ConverterParameter="28"><Binding ElementName="DeviceMetadataLine" Path="ActualWidth"/><Binding ElementName="DetailsAnchor" Path="ActualWidth"/></MultiBinding></TextBlock.MaxWidth></TextBlock>
             <ToggleButton x:Name="DetailsAnchor" Grid.Column="1" IsChecked="{Binding DetailsOpen, Mode=TwoWay}" Style="{StaticResource InlineDetailButton}" Content="详情⌄" Margin="6,0,0,0" AutomationProperties.Name="实时音频详情"/>
             <TextBlock Grid.Column="2" Text="&#xEA39;" FontFamily="Segoe Fluent Icons" Foreground="#AA713C" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="{Binding PlaybackNotice}" Visibility="{Binding HasPlaybackNotice, Converter={StaticResource Visible}}"/>
             <Popup x:Name="DeviceDetailsPopup" PlacementTarget="{Binding ElementName=DetailsAnchor}" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding DetailsOpen, Mode=TwoWay}" Tag="{Binding}" Opened="DeviceDetailsOpened">

              <Border Background="White" BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="8" Padding="13,10" MaxWidth="410"><StackPanel><TextBlock Text="实时音频详情" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding LiveDetails}" Style="{StaticResource Caption}" Margin="0,6,0,0"/><TextBlock Text="{Binding RemoteDetails}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding HasRemoteMedia, Converter={StaticResource Visible}}"/></StackPanel></Border>

             </Popup>

            </Grid>

            <Grid x:Name="RemoteMediaLine" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="22" Visibility="{Binding HasRemoteMedia, Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding TrackDescription}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding RemoteDetails}"/>
             <StackPanel x:Name="RemoteControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
              <ui:Button x:Name="RemotePrevious" Style="{StaticResource MediaRemoteButton}" Tag="previous" IsEnabled="{Binding CanPrevious}" Click="RemoteMediaClick" ToolTip="上一曲（控制此设备的播放器）" AutomationProperties.Name="上一曲，控制此设备的播放器"><TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="12"/></ui:Button>
              <ui:Button x:Name="RemotePlayPause" Style="{StaticResource MediaRemoteButton}" Tag="{Binding PlaybackAction}" IsEnabled="{Binding CanPlayPause}" Click="RemoteMediaClick" ToolTip="{Binding PlaybackHint}" AutomationProperties.Name="{Binding PlaybackHint}"><TextBlock Text="{Binding PlaybackIcon}" FontFamily="Segoe Fluent Icons" FontSize="12"/></ui:Button>
              <ui:Button x:Name="RemoteNext" Style="{StaticResource MediaRemoteButton}" Tag="next" IsEnabled="{Binding CanNext}" Click="RemoteMediaClick" ToolTip="下一曲（控制此设备的播放器）" AutomationProperties.Name="下一曲，控制此设备的播放器"><TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="12"/></ui:Button>
             </StackPanel>
            </Grid>

           </Grid>

          </Border>

         </DataTemplate></ItemsControl.ItemTemplate>

        </ItemsControl>

       </StackPanel>

      </ScrollViewer>

      <Border x:Name="DedicatedAudioFooter" Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

       <TextBlock Text="总音量" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>

       <UniformGrid Rows="1" x:Name="MasterControls" Grid.Column="1">

        <local:AudioLevel x:Name="PlaybackGain" Label="设备声音" Secondary="默认播放设备（自动跟随）" Hint="所有已连接移动设备在电脑上播放的总音量。" Tag="playback" ValueChanged="MasterGainChanged" Margin="0,0,4,0">

         <local:AudioLevel.EditorContent><StackPanel><TextBlock Text="电脑播放设备" FontSize="12" Margin="0,0,0,7"/><ComboBox Tag="OutputPicker" ItemsSource="{Binding Outputs}" DisplayMemberPath="Name" SelectionChanged="OutputChanged" AutomationProperties.Name="播放到"/></StackPanel></local:AudioLevel.EditorContent>

        </local:AudioLevel>

        <local:AudioLevel x:Name="MicrophoneGain" Label="电脑麦克风" Icon="&#xE720;" Secondary="默认麦克风（自动跟随）" Hint="电脑麦克风的音量，发送到当前使用麦克风的设备。" Tag="microphone" ValueChanged="MasterGainChanged" Margin="4,0">

         <local:AudioLevel.EditorContent><StackPanel><TextBlock Text="选择电脑麦克风" FontSize="12" Margin="0,0,0,7"/><ComboBox Tag="InputPicker" ItemsSource="{Binding Inputs}" DisplayMemberPath="Name" SelectionChanged="InputChanged" AutomationProperties.Name="电脑麦克风"/></StackPanel></local:AudioLevel.EditorContent>

         <local:AudioLevel.FooterContent><StackPanel><CheckBox Tag="MuteToggle" Content="暂停发送到设备" Style="{StaticResource Switch}" Checked="MuteChanged" Unchecked="MuteChanged" ToolTip="停止向移动设备发送麦克风和电脑声音；设备声音仍在电脑播放" AutomationProperties.Name="暂停发送到设备，停止发送麦克风和电脑声音"/><TextBlock Tag="TransmitHint" Text="停止发送麦克风和电脑声音，仍可听到移动设备。" Style="{StaticResource Caption}" Margin="24,6,0,0"/></StackPanel></local:AudioLevel.FooterContent>

        </local:AudioLevel>

        <local:AudioLevel x:Name="SystemGain" Label="电脑声音" Icon="&#xE7F4;" Secondary="使用蓝牙麦克风时加入" Hint="其他电脑应用的播放声音，与麦克风合并后发送到当前使用麦克风的设备。" Tag="system" ValueChanged="MasterGainChanged" Margin="4,0,0,0" Visibility="{Binding IsChecked, ElementName=SystemAudioToggle, Converter={StaticResource Visible}}">

         <local:AudioLevel.FooterContent><StackPanel><TextBlock Tag="SystemAudioStatus" Text="电脑声音：未加入" Style="{StaticResource Caption}"/><ui:Button Content="高级混合说明" Click="AdvancedMixClick" HorizontalAlignment="Left" FontSize="12" Padding="0,6,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}"/></StackPanel></local:AudioLevel.FooterContent>

        </local:AudioLevel>

       </UniformGrid>

       <CheckBox x:Name="SystemAudioToggle" Grid.Column="2" Content="混入电脑声音" Style="{StaticResource Switch}" Checked="SystemAudioChanged" Unchecked="SystemAudioChanged" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="把其他电脑应用的播放声音与麦克风合并发送；排除 BlueHead 接收的设备声音" AutomationProperties.Name="将电脑播放声音混入发送到设备的麦克风声音"/>

      </Grid></Border>

      <Border x:Name="SharedAudioFooter" Grid.Row="2" Style="{StaticResource Card}" Padding="10,7" Margin="0,8,0,0" Visibility="Collapsed"><DockPanel><ui:Button Content="声音设置 ↗" DockPanel.Dock="Right" Click="WindowsSoundClick" Padding="7,3" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}"/><TextBlock Text="播放设备与音量由 Windows 管理" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel></Border>

     </Grid>

     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>

      <TextBlock Text="设置" Style="{StaticResource Heading}"/><TextBlock Text="日常选项保持简单，更多参数按需调整。" Foreground="{StaticResource Muted}" Margin="0,7,0,22"/>

      <Border x:Name="SharedSettingsNotice" Background="#EEF8F7" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed"><DockPanel><ui:Button Content="切换专用接收 ↗" DockPanel.Dock="Right" Click="DedicatedSetupClick" Padding="6,3" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}"/><TextBlock Text="共用模式仅收听媒体。电脑麦克风、混音及编码选择需专用接收。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>

      <Border Style="{StaticResource Card}"><StackPanel>

       <StackPanel x:Name="SharedNameFields" Visibility="Collapsed"><TextBlock Text="系统蓝牙" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="设备配对与电脑蓝牙名称在 Windows 中管理。" Style="{StaticResource Caption}" Margin="0,8,0,8"/><ui:Button Content="打开 Windows 蓝牙 ↗" Click="WindowsBluetoothClick" HorizontalAlignment="Left" Padding="8,4"/></StackPanel>
       <StackPanel x:Name="DedicatedNameFields"><TextBlock Text="蓝牙耳机" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="耳机名称" FontSize="12" Margin="0,20,0,8"/><TextBox x:Name="NameEntry" Text="BlueHead PC" MaxLength="80"/><TextBlock Text="显示在移动设备的蓝牙列表中" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>

       <Grid x:Name="VoiceSettingsRow" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="蓝牙语音与麦克风"/><TextBlock x:Name="VoiceCodecHint" Text="语音编码：自动协商；用于通话及支持蓝牙麦克风的录音、录像应用" Style="{StaticResource Caption}" Margin="0,5,12,0"/></StackPanel><CheckBox x:Name="CallsToggle" Grid.Column="1" IsChecked="True" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="启用蓝牙语音与麦克风"/></Grid>

      </StackPanel></Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>

       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="关闭窗口后继续接收"/><TextBlock Text="BlueHead 保留在系统托盘，可右键退出" Style="{StaticResource Caption}" Margin="0,5,12,0"/></StackPanel><CheckBox x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="关闭窗口时留在托盘"/></Grid>

       <Border Height="1" Background="#EEF2F4" Margin="0,18"/>

       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="登录 Windows 后启动"/><TextBlock Text="启动后保留在托盘" Style="{StaticResource Caption}" Margin="0,5,12,0"/></StackPanel><CheckBox x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="登录 Windows 后启动"/></Grid>

      </StackPanel></Border>

      <Expander x:Name="AdvancedAudio" Header="高级音频设置" Tag="缓冲、连接上限与声音混合说明" Style="{StaticResource SectionExpander}" Margin="0,18,0,0"><Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel>

       <TextBlock Text="播放方式与媒体编码" FontWeight="SemiBold"/><TextBlock Text="在首页同一行选择：单设备自动接替，或多设备同时播放；媒体编码默认优先高清。专用接收的语音编码由双方自动协商，不随媒体编码选择改变。单设备模式在当前设备停止传音后自动接替等待播放的设备，也可点击设备名旁的标记立即切换。语音使用中保留语音优先。" Style="{StaticResource Caption}" Margin="0,7,0,16"/>

       <TextBlock Text="电脑声音混合" FontWeight="SemiBold"/><TextBlock Text="在首页“总音量”打开“加入电脑声音”即可实时启用，无需停止接收。" Style="{StaticResource Caption}" Margin="0,8,0,8"/>

       <TextBlock Text="只收录其他电脑应用的声音，排除 BlueHead 播放的移动设备声音。电脑声音与实体麦克风声音分别调节，混合后发给当前使用麦克风的设备。可在使用期间开关。" Style="{StaticResource Caption}" Margin="24,6,0,8"/>

       <TextBlock Text="需要 Windows 11 或 build 20348 以上。这里排除的是电脑内部音频，麦克风仍可能拾到扬声器外放声，使用麦克风建议戴耳机。" Style="{StaticResource Caption}" Margin="24,0,0,20"/>

       <TextBlock Text="媒体起始缓冲"/><ComboBox x:Name="MediaBufferPicker" SelectedIndex="2" Margin="0,8,0,16"><ComboBoxItem Content="30 毫秒" Tag="30"/><ComboBoxItem Content="40 毫秒" Tag="40"/><ComboBoxItem Content="60 毫秒（推荐）" Tag="60"/><ComboBoxItem Content="90 毫秒" Tag="90"/><ComboBoxItem Content="120 毫秒" Tag="120"/></ComboBox>

       <TextBlock Text="语音起始缓冲"/><ComboBox x:Name="CallBufferPicker" SelectedIndex="1" Margin="0,8,0,16"><ComboBoxItem Content="20 毫秒" Tag="20"/><ComboBoxItem Content="30 毫秒（推荐）" Tag="30"/><ComboBoxItem Content="40 毫秒" Tag="40"/><ComboBoxItem Content="60 毫秒（兼容）" Tag="60"/></ComboBox>

       <TextBlock Text="播放开始时使用所选缓冲，运行中按抖动自动调整。较小起点响应更快；这些数值不是端到端延迟。" Style="{StaticResource Caption}" Margin="0,0,0,16"/>

       <TextBlock Text="最多连接设备"/><ComboBox x:Name="MaximumPicker" SelectedIndex="2" Margin="0,8,0,16"><ComboBoxItem Content="1 台" Tag="1"/><ComboBoxItem Content="2 台" Tag="2"/><ComboBoxItem Content="3 台" Tag="3"/><ComboBoxItem Content="4 台" Tag="4"/></ComboBox>

       <CheckBox x:Name="LdacToggle" Content="启用实验性 LDAC 解码" Style="{StaticResource Switch}"/><TextBlock Text="仍需移动设备实际支持并协商成功；多设备并发能力取决于蓝牙适配器。" Style="{StaticResource Caption}" Margin="24,6,0,0"/>

      </StackPanel></Border></Expander>

      <ui:Button x:Name="SaveButton" Content="保存设置" Appearance="Primary" HorizontalAlignment="Left" Padding="12,5" Margin="0,20,0,18" Click="SaveSettingsClick"/>

      <TextBlock x:Name="SettingsHint" Style="{StaticResource Caption}"/>

     </StackPanel></ScrollViewer>

     <Grid x:Name="AdaptersPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="AdaptersScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0"><StackPanel>
      <DockPanel><ui:Button x:Name="DriverStopButton" DockPanel.Dock="Right" Content="停止接收以切换" Click="StopForSetupClick" Visibility="Collapsed" Padding="9,4"/><TextBlock Text="蓝牙接收设置" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="选择需要的功能，再按提示准备适配器。" Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
      <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
       <TextBlock Text="1  我想怎样接收" FontWeight="SemiBold" FontSize="15"/>
       <ComboBox x:Name="ModePicker" SelectedIndex="0" Margin="0,10,0,0" SelectionChanged="ModeChanged" AutomationProperties.Name="希望使用的蓝牙接收方式"><ComboBoxItem Content="声音和麦克风 · 专用适配器" Tag="advanced"/><ComboBoxItem Content="只收听媒体 · 共用 Windows 蓝牙" Tag="native"/></ComboBox>
       <TextBlock x:Name="ModeDescription" Text="专用接收支持电脑麦克风、媒体编码与多设备混音，需要独占一个适配器。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0"><StackPanel>
       <DockPanel><ui:Button DockPanel.Dock="Right" Content="刷新状态" Click="RefreshClick" Padding="7,3"/><TextBlock x:Name="DriverStepTitle" Text="2  准备蓝牙适配器" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <TextBlock x:Name="DriverStepDescription" Text="选择用于接收的内置或外置蓝牙。" Style="{StaticResource Caption}" Margin="0,7,0,10"/>
       <ComboBox x:Name="DriverPicker" DisplayMemberPath="DisplayName" SelectionChanged="DriverSelectionChanged" AutomationProperties.Name="要准备的蓝牙适配器"/>
       <TextBlock x:Name="DriverStateTitle" Text="正在检查适配器…" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,4"/>
       <TextBlock x:Name="DriverStatus" Text="正在读取状态…" Style="{StaticResource Caption}"/>
       <WrapPanel Margin="0,10,0,0"><ui:Button x:Name="InstallDriverButton" Content="启用专用接收" Appearance="Primary" Click="InstallDriverClick" Padding="10,4" Margin="0,0,8,0"/><ui:Button x:Name="RestoreDriverButton" Content="恢复系统蓝牙" Click="RestoreDriverClick" Padding="10,4"/></WrapPanel>
       <ProgressBar x:Name="DriverProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,10,0,0"/>
       <TextBlock x:Name="DriverResult" Text="" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
       <Expander Header="更多与恢复工具" Style="{StaticResource Details}" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0">
        <TextBlock Text="接收入口（多个适配器时确认）" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
        <ComboBox x:Name="AdapterPicker" DisplayMemberPath="Name" SelectionChanged="AdapterChoiceChanged" AutomationProperties.Name="BlueHead 专用接收入口"/>
        <TextBlock x:Name="DriverNativeDetails" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,0"/>
        <WrapPanel Margin="0,9,0,0"><ui:Button Content="Windows 蓝牙设置 ↗" Click="WindowsBluetoothClick" Padding="7,3" Margin="0,0,8,0"/><ui:Button Content="独立恢复工具" Click="RecoveryClick" Padding="7,3"/></WrapPanel>
       </StackPanel></Expander>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="1">
      <ui:Button x:Name="FinishBluetoothButton" Content="完成，回到音频中心" IsEnabled="False" Appearance="Primary" HorizontalAlignment="Left" Padding="12,5" Margin="0,14,0,8" Click="FinishBluetoothClick"/>
      <TextBlock x:Name="FinishBluetoothHint" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
     </StackPanel></Grid>

     <ScrollViewer x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>

      <TextBlock Text="帮助与诊断" Style="{StaticResource Heading}"/><TextBlock x:Name="HelpVersion" Text="{x:Static local:AppVersion.Title}" Foreground="{StaticResource Muted}" Margin="0,6,0,8"/><TextBlock Margin="0,0,0,18"><Hyperlink x:Name="HelpProjectLink" NavigateUri="{x:Static local:ProjectLinks.Repository}" RequestNavigate="ProjectNavigate" Foreground="{StaticResource Accent}" ToolTip="在浏览器打开项目主页">GitHub · github.com/tingol666/BlueHead ↗</Hyperlink></TextBlock>

      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="连接移动设备" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="HelpSteps" Text="1. 从首页点击设置蓝牙接收，按提示选择使用方式、准备适配器。&#x0a;&#x0a;2. 点击开始接收，在移动设备的蓝牙设置中连接 BlueHead PC。&#x0a;&#x0a;3. 开启移动设备端的媒体音频和通话音频，即可播放并使用麦克风。" Margin="0,16,0,0"/><TextBlock Text="录音、录像应用需支持并选择蓝牙麦克风，电脑端不能强制更换移动端应用的录音源。仅接收声音方式需要先在 Windows 设置中完成配对。使用麦克风建议戴电脑耳机，当前没有声学回声消除。" Style="{StaticResource Caption}" Margin="0,18,0,0"/></StackPanel></Border>

      <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="运行状态" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticsText" Text="后台正在准备…" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Margin="0,14,0,0"/><WrapPanel Margin="0,18,0,0"><ui:Button Content="刷新状态" Click="TelemetryClick" Margin="0,0,12,0"/><ui:Button Content="导出诊断报告" Click="ExportDiagnosticsClick" Margin="0,0,12,0"/><ui:Button Content="打开数据目录" Click="OpenDataClick"/></WrapPanel><TextBlock Text="导出的报告只包含版本、匿名计数和检查结果，不包含录音、配对密钥、来电号码或原始日志。" Style="{StaticResource Caption}" Margin="0,14,0,0"/></StackPanel></Border>

     </StackPanel></ScrollViewer>

    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:Button x:Name="ModeStatusButton" Content="蓝牙设置 ⌄" Click="SetupBluetoothClick" Padding="0,0,8,0" MinHeight="18" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}"/><TextBlock x:Name="FooterStatus" Grid.Column="1" Text="本机蓝牙 · 无需同一 Wi-Fi" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/><TextBlock Grid.Column="2" x:Name="EngineState" Text="后台准备中" HorizontalAlignment="Right" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>

   </Grid>

  </Grid>

 </Grid>

</ui:FluentWindow>

