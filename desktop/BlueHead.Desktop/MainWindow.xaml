     <Border x:Name="AudioOptionHelpFact" Background="#ECF8F2" CornerRadius="7" Padding="10,8" Margin="0,9,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="AudioOptionHelpFactTitle" FontSize="12" FontWeight="SemiBold" Foreground="#236544"/><TextBlock x:Name="AudioOptionHelpFactText" FontSize="12" LineHeight="18" Foreground="#426555" Margin="0,3,0,0"/></StackPanel></Border>
    </StackPanel></Border></Popup>

