       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="登录 Windows 后启动"/><TextBlock Text="登录后在托盘待命，不会自动开始接收或切换驱动" Style="{StaticResource Caption}" Margin="0,5,12,0"/></StackPanel><CheckBox x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="登录 Windows 后启动"/></Grid>

      </StackPanel></Border>

      <Expander x:Name="AdvancedAudio" Header="高级音频设置" Tag="缓冲、连接上限与声音混合说明" Style="{StaticResource SectionExpander}" Margin="0,18,0,0"><Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel>

       <TextBlock Text="播放方式与媒体编码" FontWeight="SemiBold"/><TextBlock Text="在首页同一行选择：“一次一个，自动接替”，或“所有设备一起播放”；媒体编码默认优先高清。专用接收的语音编码由双方自动协商，不随媒体编码选择改变。单设备模式在当前设备停止传音后自动接替等待播放的设备，也可点击设备名旁的标记立即切换。语音使用中保留语音优先。" Style="{StaticResource Caption}" Margin="0,7,0,16"/>

       <TextBlock Text="电脑声音混合" FontWeight="SemiBold"/><TextBlock Text="在音频中心打开“同时发送电脑声音”，将电脑其他应用的声音与麦克风一起发给设备。可随时开关，无需停止接收。" Style="{StaticResource Caption}" Margin="0,8,0,8"/>

       <TextBlock Text="只收录其他电脑应用的声音，排除 BlueHead 播放的移动设备声音。电脑声音与实体麦克风声音分别调节，混合后发给当前使用麦克风的设备。可在使用期间开关。" Style="{StaticResource Caption}" Margin="24,6,0,8"/>

       <TextBlock Text="需要 Windows 11 或 build 20348 以上。这里排除的是电脑内部音频，麦克风仍可能拾到扬声器外放声，使用麦克风建议戴耳机。" Style="{StaticResource Caption}" Margin="24,0,0,20"/>

       <TextBlock Text="媒体起始缓冲"/><ComboBox x:Name="MediaBufferPicker" SelectedIndex="2" Margin="0,8,0,16"><ComboBoxItem Content="30 毫秒" Tag="30"/><ComboBoxItem Content="40 毫秒" Tag="40"/><ComboBoxItem Content="60 毫秒（推荐）" Tag="60"/><ComboBoxItem Content="90 毫秒" Tag="90"/><ComboBoxItem Content="120 毫秒" Tag="120"/></ComboBox>

       <TextBlock Text="语音起始缓冲"/><ComboBox x:Name="CallBufferPicker" SelectedIndex="1" Margin="0,8,0,16"><ComboBoxItem Content="20 毫秒" Tag="20"/><ComboBoxItem Content="30 毫秒（推荐）" Tag="30"/><ComboBoxItem Content="40 毫秒" Tag="40"/><ComboBoxItem Content="60 毫秒（兼容）" Tag="60"/></ComboBox>

       <TextBlock Text="播放开始时使用所选缓冲，运行中按抖动自动调整。数值小，开始更快但更易受抖动影响；数值大，更能应对抖动但等待更长。保持推荐值即可；这些数值不是总延迟。" Style="{StaticResource Caption}" Margin="0,0,0,16"/>

       <TextBlock Text="最多同时连接几台设备"/><TextBlock Text="连接不等于同时播放；多设备的播放方式在音频中心选择。通话／语音保护启用时，使用电脑麦克风会暂时只保留一个设备。" Style="{StaticResource Caption}" Margin="0,5,0,0"/><ComboBox x:Name="MaximumPicker" SelectedIndex="2" Margin="0,8,0,16"><ComboBoxItem Content="1 台" Tag="1"/><ComboBoxItem Content="2 台" Tag="2"/><ComboBoxItem Content="3 台" Tag="3"/><ComboBoxItem Content="4 台" Tag="4"/></ComboBox>

       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><CheckBox x:Name="LeAudioToggle" Content="启用 LE Audio（LC3）" Style="{StaticResource Switch}"/><ComboBox x:Name="ConnectionPolicyPicker" Grid.Column="1" AutomationProperties.Name="LE Audio 连接偏好"><ComboBoxItem Content="优先 LE Audio / LC3" Tag="prefer_le"/><ComboBoxItem Content="仅经典蓝牙" Tag="classic"/><ComboBoxItem Content="仅 LE Audio / LC3" Tag="le_only"/></ComboBox></Grid><TextBlock Text="与首页媒体编码右侧的设置同步。双模保留经典连接；仅 LE Audio 关闭经典音频入口，适合重新配对 LC3。修改自动保存，下次开始接收生效。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,6,0,0"/>
       <ui:Button x:Name="LePairingGuideButton" Content="LE 配对指南 · 手机没有 LC3？" Click="LePairingGuideClick" HorizontalAlignment="Left" Margin="24,8,0,0" Padding="8,4" FontSize="12"/><TextBlock x:Name="LeAudioState" Text="开始接收后，这里显示适配器的 LE Audio 能力。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,6,0,0"/>
       <TextBlock Text="LE Audio 自动协商 LC3 编码与播放时延，首页“媒体编码”和上方起始缓冲用于经典蓝牙音频。对端可同时提供两种连接，实际协议显示在设备卡片中。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,6,0,0"/>
