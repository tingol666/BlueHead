<ui:FluentWindow x:Class="BlueHead.Desktop.MainWindow"

 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:BlueHead.Desktop"

 Title="{x:Static local:AppVersion.Title}" Width="940" Height="580" MinWidth="860" MinHeight="480" WindowStartupLocation="CenterScreen"

 Background="#F7FAFB" Foreground="#26303C" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

 <Grid Background="#F7FAFB">

  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <ui:TitleBar Title="{x:Static local:AppVersion.Title}" Grid.Row="0" Padding="16,0" />

  <Grid Grid.Row="1">

   <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border Background="#F0F6F7" BorderBrush="#E0EAED" BorderThickness="0,0,1,0">

    <DockPanel Margin="10,19,10,16">

     <StackPanel DockPanel.Dock="Bottom" Margin="14,0,0,0"><TextBlock x:Name="SidebarVersion" Text="{x:Static local:AppVersion.Label}" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse Width="5" Height="5" Fill="#0A8A7A" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="本机蓝牙连接" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>

     <StackPanel>

      <StackPanel Orientation="Horizontal" Margin="6,0,0,22"><Border Background="#07C160" Width="26" Height="26" CornerRadius="8"><TextBlock Text="&#xE95B;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"><Hyperlink x:Name="BrandProjectLink" NavigateUri="{x:Static local:ProjectLinks.Repository}" RequestNavigate="ProjectNavigate" TextDecorations="{x:Null}" Foreground="{StaticResource Ink}" ToolTip="GitHub 项目主页 · https://github.com/tingol666/BlueHead" AutomationProperties.Name="BlueHead GitHub 项目主页">BlueHead<Run Text=" ↗" FontSize="11" Foreground="{StaticResource Accent}"/></Hyperlink></TextBlock></StackPanel>

      <Button x:Name="NavHome" Style="{StaticResource Nav}" Click="HomeClick" AutomationProperties.Name="音频中心"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="音频中心"/></StackPanel></Button>

      <Button x:Name="NavBroadcast" Style="{StaticResource Nav}" Click="BroadcastClick" AutomationProperties.Name="音频广播"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE704;" Style="{StaticResource NavIcon}"/><TextBlock Text="音频广播"/></StackPanel></Button>

      <Button x:Name="NavAdapters" Style="{StaticResource Nav}" Click="AdaptersClick" AutomationProperties.Name="蓝牙驱动设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE702;" Style="{StaticResource NavIcon}"/><TextBlock Text="蓝牙驱动设置"/></StackPanel></Button>

      <Button x:Name="NavSettings" Style="{StaticResource Nav}" Click="SettingsClick" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="设置"/></StackPanel></Button>

      <Button x:Name="NavHelp" Style="{StaticResource Nav}" Click="HelpClick" AutomationProperties.Name="帮助与诊断"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}"/><TextBlock Text="帮助与诊断"/></StackPanel></Button>

     </StackPanel>

    </DockPanel>

   </Border>

   <Grid Grid.Column="1" Margin="20,15,20,10">

    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border x:Name="Notice" Visibility="Collapsed" Background="#FFF2DF" CornerRadius="7" Padding="10,8" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" Foreground="#805015" VerticalAlignment="Center"/><ui:Button x:Name="NoticeAction" Grid.Column="1" Content="处理蓝牙问题" Click="SetupBluetoothClick" Visibility="Collapsed" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></Border>

    <Grid Grid.Row="1">

     <Grid x:Name="HomePage">

      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Grid x:Name="HomeHeader" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

       <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="音频中心" Style="{StaticResource Heading}" VerticalAlignment="Center"/><TextBlock x:Name="DeviceCount" Text="0 台设备" FontSize="11" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>

       <ui:Button x:Name="ModeStatusButton" Grid.Column="1" Content="驱动设置" Click="SetupBluetoothClick" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}"/>

       <StackPanel x:Name="ReceptionStatus" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><StackPanel.ToolTip><ToolTip><TextBlock x:Name="StatusDetail" Text="检查本机蓝牙与音频设备…" MaxWidth="300"/></ToolTip></StackPanel.ToolTip><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#98A1AF" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="StatusTitle" Text="正在准备" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/><TextBlock x:Name="MutedIndicator" Text="发送暂停" Visibility="Collapsed" Foreground="#A45E28" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>

       <ui:Button x:Name="StartButton" Grid.Column="3" Content="正在准备…" IsEnabled="False" Appearance="Primary" VerticalAlignment="Center" Padding="12,5" Click="StartClick" AutomationProperties.Name="开始接收或设置蓝牙接收"/>

      </Grid>

      <ScrollViewer x:Name="HomeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">

       <StackPanel>
        <Border x:Name="HomeModeCard" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8"><StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0"><TextBlock Text="蓝牙使用方式" FontSize="12" VerticalAlignment="Center"/><ui:Button x:Name="UsageHelpButton" Content="ⓘ" Tag="usage" Click="AudioOptionHelpClick" Padding="2,0" MinHeight="20" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AudioAccent}" Margin="3,0,0,0" ToolTip="点击了解共用与专用蓝牙的区别和切换步骤" AutomationProperties.Name="蓝牙使用方式说明，点击查看"/></StackPanel>
          <ComboBox x:Name="HomeModePicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="HomeModeChanged" AutomationProperties.Name="蓝牙使用方式，Windows 共用或 BlueHead 专用"><ComboBoxItem Content="BlueHead 专用（进阶）" Tag="advanced"/><ComboBoxItem Content="Windows 共用（基础）" Tag="native"/></ComboBox>
          <TextBlock x:Name="HomeModeState" Grid.Column="3" Text="正在检查" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
         </Grid>
         <TextBlock x:Name="HomeModeSummary" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
         <TextBlock x:Name="HomeNextStep" FontSize="12" Margin="0,4,0,0"/>
         <ui:Button x:Name="HomePairButton" Content="打开 Windows 蓝牙 ↗" Click="WindowsBluetoothClick" HorizontalAlignment="Left" Padding="7,3" Margin="0,7,0,0" Visibility="Collapsed"/>
        </StackPanel></Border>

        <Border x:Name="HomeUsageNotice" Background="#EAF7F0" CornerRadius="7" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock x:Name="HomeUsageTitle" Foreground="#236544" FontSize="14" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="HomeUsageText" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
        <Border x:Name="VoiceProtectionNotice" Visibility="Collapsed" Background="#EAF7F0" BorderBrush="#CBEBD8" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,10"><TextBlock x:Name="VoiceProtectionText" Foreground="#236544" FontSize="12"/></Border>

        <Border x:Name="SharedModeNotice" Background="#EEF8F7" CornerRadius="8" Padding="10,7" Margin="0,0,0,8" Visibility="Collapsed"><DockPanel><ui:Button Content="使用电脑麦克风 ↗" DockPanel.Dock="Right" Click="DedicatedSetupClick" Padding="6,3" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/><TextBlock Text="共用 Windows 蓝牙 · 仅接收媒体。麦克风与混音需专用接收。" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>

        <Border x:Name="MediaProfileCard" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8"><StackPanel>

         <Grid x:Name="PlaybackOptionsRow"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock Text="多设备播放" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ui:Button x:Name="PlaybackHelpButton" Content="ⓘ" Tag="devices" Click="AudioOptionHelpClick" Padding="2,0" MinHeight="20" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AudioAccent}" Margin="3,0,0,0" ToolTip="点击了解多台设备连接时的播放方式" AutomationProperties.Name="多设备播放说明，点击查看"/></StackPanel>

          <ComboBox x:Name="PlaybackModePicker" Grid.Column="1" FontSize="12" SelectedIndex="0" SelectionChanged="PlaybackModeChanged" AutomationProperties.Name="同时连接多个设备时的声音播放方式"><ComboBox.ToolTip><ToolTip><TextBlock x:Name="MediaModeHint" Text="多设备声音一起播放，可分别调节音量。" MaxWidth="320"/></ToolTip></ComboBox.ToolTip><ComboBoxItem Content="同时播放" Tag="mix"/><ComboBoxItem Content="单台自动接替" Tag="single"/></ComboBox>

          <TextBlock x:Name="SharedPlaybackValue" Grid.Column="1" Text="Windows 管理" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock x:Name="MediaCodecLabel" Text="媒体编码" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ui:Button x:Name="CodecHelpButton" Content="ⓘ" Tag="codec" Click="AudioOptionHelpClick" Padding="2,0" MinHeight="20" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AudioAccent}" Margin="3,0,0,0" ToolTip="点击了解媒体编码用途和选择建议" AutomationProperties.Name="媒体编码说明，点击查看"/></StackPanel>

          <ComboBox x:Name="CodecPicker" Grid.Column="4" FontSize="12" SelectedIndex="0" SelectionChanged="CodecChanged" AutomationProperties.Name="媒体编码" ToolTipService.ShowOnDisabled="True">
           <ComboBox.ToolTip><ToolTip><TextBlock x:Name="CodecHint" Text="优先协商可用高清媒体编码；多设备断续时可切换 AAC。仅影响媒体播放，语音编码自动协商。" MaxWidth="320"/></ToolTip></ComboBox.ToolTip>
           <ComboBoxItem Content="自动 · 优先高清" Tag="auto"/>
           <ComboBoxItem Content="LHDC 5.0" Tag="lhdc5"/>
           <ComboBoxItem Content="LDAC" Tag="ldac"/>
           <ComboBoxItem Content="aptX HD" Tag="aptx_hd"/>
           <ComboBoxItem Content="aptX" Tag="aptx"/>
           <ComboBoxItem Content="AAC" Tag="aac"/>
           <ComboBoxItem Content="SBC" Tag="sbc"/>
          </ComboBox>

          <TextBlock x:Name="SharedCodecValue" Grid.Column="4" Text="Windows 自动选择" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/>

          <ui:Button x:Name="CodecSettingsButton" Grid.Column="5" Click="CodecSettingsClick" Padding="6,4" MinHeight="26" Margin="5,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}" AutomationProperties.Name="连接与编码设置">
           <ui:Button.ToolTip><ToolTip FontFamily="Segoe UI, Microsoft YaHei UI"><TextBlock Text="连接与编码：LE Audio 偏好、允许的编码与首选编码" FontFamily="Segoe UI, Microsoft YaHei UI" MaxWidth="300"/></ToolTip></ui:Button.ToolTip>
           <Viewbox Width="16" Height="16"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="F0 M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.42,11.02 L21.53,9.37 C21.72,9.22 21.77,8.95 21.65,8.73 L19.65,5.27 C19.53,5.05 19.27,4.97 19.05,5.05 L16.56,6.05 C16.04,5.65 15.49,5.32 14.88,5.07 L14.5,2.42 C14.47,2.18 14.26,2 14.01,2 L10.01,2 C9.76,2 9.56,2.18 9.52,2.42 L9.14,5.07 C8.53,5.32 7.97,5.66 7.46,6.05 L4.97,5.05 C4.74,4.96 4.49,5.05 4.37,5.27 L2.37,8.73 C2.24,8.95 2.3,9.22 2.49,9.37 L4.6,11.02 C4.55,11.34 4.51,11.67 4.51,12 C4.51,12.33 4.54,12.66 4.59,12.98 L2.48,14.63 C2.29,14.78 2.24,15.05 2.36,15.27 L4.36,18.73 C4.48,18.95 4.74,19.03 4.96,18.95 L7.45,17.95 C7.97,18.35 8.52,18.68 9.13,18.93 L9.51,21.58 C9.55,21.82 9.75,22 10,22 L14,22 C14.25,22 14.46,21.82 14.49,21.58 L14.87,18.93 C15.48,18.68 16.04,18.35 16.55,17.95 L19.04,18.95 C19.27,19.04 19.52,18.95 19.64,18.73 L21.64,15.27 C21.76,15.05 21.71,14.78 21.52,14.63 Z M15.5,12 A3.5,3.5 0 1 1 8.5,12 A3.5,3.5 0 1 1 15.5,12 Z"/></Viewbox>
          </ui:Button>

         </Grid>






         <Border x:Name="CodecReconnectNotice" Visibility="Collapsed" Background="#FFF7EB" CornerRadius="6" Padding="8,6" Margin="0,7,0,0"><TextBlock x:Name="CodecReconnectText" FontSize="12" Foreground="#80551E" AutomationProperties.LiveSetting="Polite"/></Border>
         <Border x:Name="MultipointNotice" Visibility="Collapsed" Background="#FFF7EB" CornerRadius="6" Padding="8,6" Margin="0,7,0,0"><DockPanel><ui:Button x:Name="LowerBitrateButton" DockPanel.Dock="Right" Content="编码设置…" Click="LowerBitrateClick" Margin="8,0,0,0" Padding="8,4" VerticalAlignment="Center"/><TextBlock x:Name="MultipointText" Style="{StaticResource Caption}" Foreground="#946032" VerticalAlignment="Center"/></DockPanel></Border>

        </StackPanel></Border>

        <Border x:Name="SetupCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8"><StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SetupTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><ui:Button x:Name="SetupAction" Grid.Column="1" Content="打开蓝牙驱动设置" Click="SetupBluetoothClick" Padding="9,4" Margin="12,0,0,0"/></Grid>
         <TextBlock x:Name="SetupDescription" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
         <Border x:Name="SetupBenefits" Visibility="Collapsed"/><TextBlock x:Name="SetupCaption" Visibility="Collapsed"/>
        </StackPanel></Border>

        <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="30" Height="34" CornerRadius="8" Background="#F0F2F6" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="&#xE95B;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="等待设备连接" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="PairingHint" Text="开始接收后，在移动设备的蓝牙设置中连接 BlueHead PC。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><ui:Button Grid.Column="2" Content="连接步骤" Click="PairingClick" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Padding="6,4"/></Grid></Border>

        <ItemsControl x:Name="DeviceCards" ItemsSource="{Binding Devices}">

         <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:DeviceCard}">

          <Border Style="{StaticResource Card}" Padding="12,7" Margin="0,0,0,5">

           <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <Border Grid.RowSpan="2" Width="24" Height="28" CornerRadius="6" Background="#F0F2F6" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons" Foreground="#7C8797" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

            <Grid x:Name="DeviceNameLine" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Name}"><TextBlock.MaxWidth><MultiBinding Converter="{StaticResource InlineWidth}" ConverterParameter="8"><Binding ElementName="DeviceNameLine" Path="ActualWidth"/><Binding ElementName="SelectionBadge" Path="ActualWidth"/><Binding Path="CanSelectMedia"/></MultiBinding></TextBlock.MaxWidth></TextBlock>
             <ui:Button x:Name="SelectionBadge" Grid.Column="1" Content="{Binding MediaAction}" Visibility="{Binding CanSelectMedia, Converter={StaticResource Visible}}" Click="SelectMediaClick" Padding="7,2" MinHeight="22" FontSize="11" Margin="8,0,0,0" ToolTip="点击立即切换；当前设备停止传音后会自动接替"><ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Background" Value="#F5F6F8"/><Setter Property="Foreground" Value="#6B7686"/><Setter Property="BorderBrush" Value="#E3ECEF"/><Style.Triggers><DataTrigger Binding="{Binding IsMediaSelected}" Value="True"><Setter Property="Background" Value="#E8F8EF"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="#CDEDDC"/></DataTrigger></Style.Triggers></Style></ui:Button.Style></ui:Button>
            </Grid>

            <StackPanel x:Name="DeviceActions" Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">

             <ui:Button Content="接听" Appearance="Primary" Visibility="{Binding CanAnswer, Converter={StaticResource Visible}}" IsEnabled="{Binding CanAnswer}" Margin="0,0,6,0" Click="AnswerClick" Padding="9,4"/>

             <local:AudioLevel Label="此设备 → 电脑" CompactLabel="播放" Hint="只调节这个设备在电脑上播放的音量；还会受底部“设备声音”总音量控制。" Compact="True" Value="{Binding Volume, Mode=TwoWay}" ValueChanged="GainChanged" IsEnabled="{Binding CanMix}" Margin="0,0,6,0"/>

             <local:AudioLevel Label="发送到此设备" CompactLabel="麦克风发送" Hint="调节发给这个设备的音量。来源是电脑麦克风，以及已开启的电脑声音；不影响你在电脑听到的声音。" Icon="&#xE720;" Compact="True" Value="{Binding UplinkVolume, Mode=TwoWay}" ValueChanged="UplinkGainChanged" IsEnabled="{Binding CanMix}"/>

             <ui:Button ToolTip="设备操作" AutomationProperties.Name="设备操作" Padding="6,4" MinHeight="26" BorderThickness="0" Background="Transparent" Margin="5,0,0,0"><ui:Button.Content><TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="14"/></ui:Button.Content><ui:Button.ContextMenu><ContextMenu><MenuItem Header="断开连接" Click="DisconnectClick"/></ContextMenu></ui:Button.ContextMenu><ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><EventSetter Event="Click" Handler="DeviceMenuClick"/></Style></ui:Button.Style></ui:Button>

            </StackPanel>

            <Grid x:Name="DeviceMetadataLine" Grid.Row="1" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding MediaDescription}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding MediaDescription}"><TextBlock.MaxWidth><MultiBinding Converter="{StaticResource InlineWidth}" ConverterParameter="28"><Binding ElementName="DeviceMetadataLine" Path="ActualWidth"/><Binding ElementName="DetailsAnchor" Path="ActualWidth"/></MultiBinding></TextBlock.MaxWidth></TextBlock>
             <ToggleButton x:Name="DetailsAnchor" Grid.Column="1" IsChecked="{Binding DetailsOpen, Mode=TwoWay}" Style="{StaticResource InlineDetailButton}" Content="详情⌄" Margin="6,0,0,0" AutomationProperties.Name="实时音频详情"/>
             <TextBlock Grid.Column="2" Text="&#xEA39;" FontFamily="Segoe Fluent Icons" Foreground="#AA713C" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasPlaybackNotice, Converter={StaticResource Visible}}"><TextBlock.ToolTip><ToolTip FontFamily="Segoe UI, Microsoft YaHei UI"><TextBlock Text="{Binding PlaybackNotice}" FontFamily="Segoe UI, Microsoft YaHei UI" MaxWidth="300"/></ToolTip></TextBlock.ToolTip></TextBlock>
             <Popup x:Name="DeviceDetailsPopup" PlacementTarget="{Binding ElementName=DetailsAnchor}" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding DetailsOpen, Mode=TwoWay}" Tag="{Binding}" Opened="DeviceDetailsOpened">

              <Border Background="White" BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="8" Padding="13,10" MaxWidth="410"><StackPanel><TextBlock Text="实时音频详情" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding LiveDetails}" Style="{StaticResource Caption}" Margin="0,6,0,0"/><TextBlock Text="{Binding CodecNote}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasCodecNote, Converter={StaticResource Visible}}"/><TextBlock Text="{Binding RemoteDetails}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding HasRemoteMedia, Converter={StaticResource Visible}}"/></StackPanel></Border>

             </Popup>

            </Grid>

            <Grid x:Name="RemoteMediaLine" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="22" Visibility="{Binding HasRemoteMedia, Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding TrackDescription}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding RemoteDetails}"/>
             <StackPanel x:Name="RemoteControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
              <ui:Button x:Name="RemotePrevious" Style="{StaticResource MediaRemoteButton}" Tag="previous" IsEnabled="{Binding CanPrevious}" Click="RemoteMediaClick" ToolTip="上一曲（控制此设备的播放器）" AutomationProperties.Name="上一曲，控制此设备的播放器"><TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="12"/></ui:Button>
              <ui:Button x:Name="RemotePlayPause" Style="{StaticResource MediaRemoteButton}" Tag="{Binding PlaybackAction}" IsEnabled="{Binding CanPlayPause}" Click="RemoteMediaClick" ToolTip="{Binding PlaybackHint}" AutomationProperties.Name="{Binding PlaybackHint}"><TextBlock Text="{Binding PlaybackIcon}" FontFamily="Segoe Fluent Icons" FontSize="12"/></ui:Button>
