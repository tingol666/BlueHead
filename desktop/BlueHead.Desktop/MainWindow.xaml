       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="关闭窗口后继续接收"/><TextBlock Text="BlueHead 保留在系统托盘，可右键退出" Style="{StaticResource Caption}" Margin="0,5,12,0"/></StackPanel><CheckBox x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="关闭窗口时留在托盘"/></Grid>

